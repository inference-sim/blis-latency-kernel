# Compiled command binaries. `go build ./cmd/...` drops them in the repo root, and two were
# committed by accident at 4 MB each; they are rebuildable from source and platform-specific.
/baseline
/shape
/score
/worked-table
/kernelscore
/overlap-probe
/bandprobe

# Go test and coverage output
*.test
*.out

# Python bytecode is build output, never source
__pycache__/
*.pyc

# Test inputs that are not this repository's to distribute.
#
# The upstream catalog and registry, fetched at the commits testdata/upstream.lock pins by
# scripts/fetch-testdata.sh.
/testdata/catalog/
/testdata/registry/
# Measurement corpora extracted from third-party publications by scripts/extract_*. Read by
# cmd/score, cmd/shape and the `scoring` test suite from BLIS_MEASUREMENTS or here.
/testdata/measurements/
